@model TripMitraHolidays.Core.Models.Inquiry
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Enquiry #" + Model.InquiryId;
}

@* ── Toolbar ── *@
<div class="page-toolbar">
    <div class="toolbar-left">
        <a href="@Url.Action("Index")" class="btn-back">
            <svg viewBox="0 0 24 24" width="16" height="16" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
            </svg>
            Back to Enquiries
        </a>
        <h1 class="toolbar-title">Enquiry #@Model.InquiryId</h1>
    </div>
    <div class="toolbar-right"></div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:960px;">

    @* ── Contact Details ── *@
    <div class="detail-card">
        <div class="detail-card-title">
            <svg viewBox="0 0 24 24" width="18" height="18" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
            </svg>
            Contact Details
        </div>
        <div class="detail-fields">
            <div class="detail-field">
                <span class="detail-label">Full Name</span>
                <span class="detail-value">@Model.FullName</span>
            </div>
            <div class="detail-field">
                <span class="detail-label">Mobile Number</span>
                <span class="detail-value">
                    <a href="tel:@Model.MobileNumber" style="color:#0d1b4b;font-weight:700;">@Model.MobileNumber</a>
                </span>
            </div>
            <div class="detail-field">
                <span class="detail-label">Email Address</span>
                <span class="detail-value">
                    <a href="mailto:@Model.EmailAddress" style="color:#0d1b4b;">@Model.EmailAddress</a>
                </span>
            </div>
            <div class="detail-field">
                <span class="detail-label">City</span>
                <span class="detail-value">@(string.IsNullOrEmpty(Model.City) ? "—" : Model.City)</span>
            </div>
            <div class="detail-field">
                <span class="detail-label">Received On</span>
                <span class="detail-value">@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
            </div>
        </div>
    </div>

    @* ── Trip Details ── *@
    <div class="detail-card">
        <div class="detail-card-title">
            <svg viewBox="0 0 24 24" width="18" height="18" xmlns="http://www.w3.org/2000/svg">
                <path d="M21 3L3 10.53v.98l6.84 2.65L12.48 21h.98L21 3z"/>
            </svg>
            Trip Details
        </div>
        <div class="detail-fields">
            <div class="detail-field">
                <span class="detail-label">Preferred Destination</span>
                <span class="detail-value detail-highlight">
                    @(string.IsNullOrEmpty(Model.PreferredDestination) ? "—" : Model.PreferredDestination)
                </span>
            </div>
            <div class="detail-field">
                <span class="detail-label">Travel Date</span>
                <span class="detail-value">
                    @(Model.TravelDate.HasValue ? Model.TravelDate.Value.ToString("dd MMM yyyy") : "—")
                </span>
            </div>
            <div class="detail-field">
                <span class="detail-label">Number of Persons</span>
                <span class="detail-value">@(Model.NumberOfPersons.HasValue ? Model.NumberOfPersons.ToString() : "—")</span>
            </div>
            <div class="detail-field">
                <span class="detail-label">Budget</span>
                <span class="detail-value detail-highlight">
                    @if (Model.Budget.HasValue)
                    {
                        <i class="fa-solid fa-indian-rupee-sign"></i>@Model.Budget.Value.ToString("N0")
                    }
                    else
                    {
                        <text>—</text>
                    }
                </span>
            </div>
        </div>
    </div>

</div>

@* ── Message ── *@
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="detail-card" style="max-width:960px;margin-top:20px;">
        <div class="detail-card-title">
            <svg viewBox="0 0 24 24" width="18" height="18" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/>
            </svg>
            Message from Customer
        </div>
        <p style="font-size:13px;color:#444;line-height:1.8;padding:4px 0;">@Model.Message</p>
    </div>
}

@* ── Quick Actions ── *@
<div class="detail-card" style="max-width:960px;margin-top:20px;">
    <div class="detail-card-title">
        <svg viewBox="0 0 24 24" width="18" height="18" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
        </svg>
        Quick Actions
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:4px;">
        <a href="tel:@Model.MobileNumber" class="btn-action-lg btn-call">
            <svg viewBox="0 0 24 24" width="16" height="16" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            Call @Model.MobileNumber
        </a>
        <a href="mailto:@Model.EmailAddress?subject=Re:%20Your%20Holiday%20Enquiry%20-%20TripMitra%20Holidays"
           class="btn-action-lg btn-email">
            <svg viewBox="0 0 24 24" width="16" height="16" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            Reply via Email
        </a>
        <a href="https://wa.me/@(Model.MobileNumber.Replace("+","").Replace("-","").Replace(" ",""))?text=Hi%20@Uri.EscapeDataString(Model.FullName.Split(' ')[0])%2C%20this%20is%20TripMitra%20Holidays.%20Thank%20you%20for%20your%20enquiry!%20We%27d%20love%20to%20help%20you%20plan%20your%20trip."
           class="btn-action-lg btn-whatsapp" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" xmlns="http://www.w3.org/2000/svg">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp @Model.FullName.Split(' ')[0]
        </a>

        @* ── Delete — separated with a divider ── *@
        <div style="width:1px;height:36px;background:#e5e7eb;margin:0 4px;"></div>
        @using (Html.BeginForm("Delete", "Enquiries", FormMethod.Post, new { id = "deleteForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.InquiryId" />
            <button type="button" class="btn-action-lg btn-delete-enquiry"
                    onclick="if(confirm('Delete this enquiry? This cannot be undone.')) document.getElementById('deleteForm').submit();">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                </svg>
                Delete Enquiry
            </button>
        }
    </div>
</div>
