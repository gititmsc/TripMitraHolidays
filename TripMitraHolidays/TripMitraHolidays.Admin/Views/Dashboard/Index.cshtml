@{
    ViewBag.Title = "Dashboard";
    ViewBag.PageTitle = "Dashboard";
}

<div class="page-header">
    <h1>Dashboard</h1>
    <p>Welcome back, @User.Identity.Name &mdash; here's what's happening today.</p>
</div>

@* ── Stat Cards ── *@
<div class="stats-grid">

    <div class="stat-card">
        <div class="stat-icon-wrap navy">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 6h-2.18c.07-.44.18-.88.18-1.36C18 2.53 15.47 0 12.36 0c-1.73 0-3.24.88-4.14 2.2L12 6H20zm-8.84 0l-3.44-4.47A5.02 5.02 0 0 0 6 4.64c0 .48.08.92.18 1.36H4C2.9 6 2 6.9 2 8v2c0 1.1.9 2 2 2h.44l1.44 7.22A2 2 0 0 0 7.85 21h8.3c.96 0 1.8-.68 1.97-1.63L19.56 12H20c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2H11.16z"/>
            </svg>
        </div>
        <div class="stat-info">
            <div class="stat-value">0</div>
            <div class="stat-label">Total Packages</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon-wrap gold">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/>
            </svg>
        </div>
        <div class="stat-info">
            <div class="stat-value">0</div>
            <div class="stat-label">Total Enquiries</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon-wrap green">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
            </svg>
        </div>
        <div class="stat-info">
            <div class="stat-value">0</div>
            <div class="stat-label">Admin Users</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon-wrap purple">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
            </svg>
        </div>
        <div class="stat-info">
            <div class="stat-value">&#x20B9;0</div>
            <div class="stat-label">Total Revenue</div>
        </div>
    </div>

</div>

@* ── Recent Enquiries placeholder ── *@
<div class="admin-card">
    <div class="admin-card-header">
        <h2 class="admin-card-title">Recent Enquiries</h2>
        <a href="@Url.Action("Index", "Enquiries")" style="font-size:0.82rem;color:#c4981e;text-decoration:none;font-weight:600;">
            View All &rarr;
        </a>
    </div>
    <div class="admin-card-body" style="padding:0;">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Customer Name</th>
                    <th>Package</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="5" style="text-align:center;padding:32px 16px;color:#9ca3af;font-size:0.875rem;">
                        No enquiries yet.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@* ── Quick Links ── *@
<div class="stats-grid" style="margin-bottom:0;">
    <a href="@Url.Action("Index", "Packages")" style="text-decoration:none;">
        <div class="admin-card" style="padding:20px 22px;display:flex;align-items:center;gap:14px;cursor:pointer;margin-bottom:0;transition:box-shadow .2s,transform .2s;">
            <div class="stat-icon-wrap navy">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/>
                </svg>
            </div>
            <div>
                <div style="font-size:.88rem;font-weight:600;color:#1b2d6f;">Manage Packages</div>
                <div style="font-size:.77rem;color:#9ca3af;">Add or edit travel packages</div>
            </div>
        </div>
    </a>
    <a href="@Url.Action("Index", "Enquiries")" style="text-decoration:none;">
        <div class="admin-card" style="padding:20px 22px;display:flex;align-items:center;gap:14px;cursor:pointer;margin-bottom:0;">
            <div class="stat-icon-wrap gold">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
                </svg>
            </div>
            <div>
                <div style="font-size:.88rem;font-weight:600;color:#1b2d6f;">View Enquiries</div>
                <div style="font-size:.77rem;color:#9ca3af;">Review customer enquiries</div>
            </div>
        </div>
    </a>
    <a href="@Url.Action("Index", "Users")" style="text-decoration:none;">
        <div class="admin-card" style="padding:20px 22px;display:flex;align-items:center;gap:14px;cursor:pointer;margin-bottom:0;">
            <div class="stat-icon-wrap green">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
            </div>
            <div>
                <div style="font-size:.88rem;font-weight:600;color:#1b2d6f;">Manage Users</div>
                <div style="font-size:.77rem;color:#9ca3af;">Admin user management</div>
            </div>
        </div>
    </a>
</div>
