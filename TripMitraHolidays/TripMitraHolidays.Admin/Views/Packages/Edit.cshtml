@model TripMitraHolidays.Core.ViewModels.PackageFormViewModel
@{
    ViewBag.Title = "Edit Package";
    ViewBag.PageTitle = "Edit Package";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
    <div>
        <h1>Edit Package</h1>
        <p>@Model.PackageName</p>
    </div>
    <div style="display:flex;gap:8px;">
        <a href="@Url.Action("Details", new { id = Model.PackageId })" class="btn-secondary-admin">View Details</a>
        <a href="@Url.Action("Index")" class="btn-secondary-admin">&larr; Back</a>
    </div>
</div>

@using (Html.BeginForm("Edit", "Packages", new { id = Model.PackageId }, FormMethod.Post, new { enctype = "multipart/form-data", id = "packageForm", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.PackageId)
    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

    @Html.HiddenFor(m => m.ExistingThumbnailImage)
    @Html.HiddenFor(m => m.ExistingBannerImage)
    @Html.HiddenFor(m => m.ItinerariesJson, new { id = "ItinerariesJson" })
    @Html.HiddenFor(m => m.InclusionsJson,  new { id = "InclusionsJson"  })
    @Html.HiddenFor(m => m.ExclusionsJson,  new { id = "ExclusionsJson"  })

    <div class="pkg-form-grid">

        @* ─── LEFT COLUMN ─────────────────────────────────────── *@
        <div class="pkg-col-main">

            @* SECTION 1 — Basic Details *@
            <div class="form-section">
                <div class="form-section-header">
                    <span class="form-section-num">1</span>
                    <h3 class="form-section-title">Basic Details</h3>
                </div>
                <div class="form-section-body">
                    <div class="form-row-2">
                        <div class="form-group">
                            @Html.LabelFor(m => m.PackageName, new { @class = "form-label required" })
                            @Html.TextBoxFor(m => m.PackageName, new { @class = "form-control", id = "PackageName" })
                            @Html.ValidationMessageFor(m => m.PackageName, "", new { @class = "field-error" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.Slug, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Slug, new { @class = "form-control", id = "Slug" })
                            <span class="field-hint">Leave blank to auto-generate</span>
                        </div>
                    </div>
                    <div class="form-row-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Destination, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Destination, new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.Country, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Country, new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.StartingCity, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.StartingCity, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="form-row-2">
                        <div class="form-group">
                            @Html.LabelFor(m => m.PackageType, new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.PackageType, new SelectList(new[] {
                                "","Domestic","International","Pilgrimage","Adventure","Honeymoon","Corporate","Group","Custom"
                            }, Model.PackageType), "-- Select Type --", new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.TourCategory, new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.TourCategory, new SelectList(new[] {
                                "","Beach","Mountains","Historical","Wildlife","Cultural","Religious","Luxury","Budget","Family","Couple"
                            }, Model.TourCategory), "-- Select Category --", new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>

            @* SECTION 2 — Pricing *@
            <div class="form-section">
                <div class="form-section-header">
                    <span class="form-section-num">2</span>
                    <h3 class="form-section-title">Pricing</h3>
                </div>
                <div class="form-section-body">
                    <div class="form-row-2">
                        <div class="form-group">
                            @Html.LabelFor(m => m.PackagePrice, new { @class = "form-label required" })
                            <div class="input-prefix-wrap">
                                <span class="input-prefix">&#x20B9;</span>
                                @Html.TextBoxFor(m => m.PackagePrice, new { @class = "form-control with-prefix", type = "number", min = "0", step = "0.01" })
                            </div>
                            @Html.ValidationMessageFor(m => m.PackagePrice, "", new { @class = "field-error" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.DiscountPrice, new { @class = "form-label" })
                            <div class="input-prefix-wrap">
                                <span class="input-prefix">&#x20B9;</span>
                                @Html.TextBoxFor(m => m.DiscountPrice, new { @class = "form-control with-prefix", type = "number", min = "0", step = "0.01" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* SECTION 3 — Tour Details *@
            <div class="form-section">
                <div class="form-section-header">
                    <span class="form-section-num">3</span>
                    <h3 class="form-section-title">Tour Details</h3>
                </div>
                <div class="form-section-body">
                    <div class="form-row-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.DurationDays, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.DurationDays, new { @class = "form-control", type = "number", min = "1" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.DurationNights, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.DurationNights, new { @class = "form-control", type = "number", min = "0" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.HotelRating, new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.HotelRating, new SelectList(new[] {
                                "","3 Star","4 Star","5 Star","Budget","Luxury","Not Applicable"
                            }, Model.HotelRating), "-- Select --", new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="form-row-2">
                        <div class="form-group">
                            @Html.LabelFor(m => m.MealType, new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.MealType, new SelectList(new[] {
                                "","Breakfast Only","Half Board","Full Board","All Inclusive","Not Included"
                            }, Model.MealType), "-- Select --", new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.Transportation, new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.Transportation, new SelectList(new[] {
                                "","Flight","Train","Bus","Private Car","Cruise","Self Drive","Multiple"
                            }, Model.Transportation), "-- Select --", new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>

            @* SECTION 4 — Images *@
            <div class="form-section">
                <div class="form-section-header">
                    <span class="form-section-num">4</span>
                    <h3 class="form-section-title">Images</h3>
                </div>
                <div class="form-section-body">
                    <div class="form-row-2">
                        <div class="form-group">
                            <label class="form-label">Thumbnail Image</label>
                            @if (!string.IsNullOrEmpty(Model.ExistingThumbnailImage))
                            {
                                <div class="existing-image-wrap">
                                    <img src="@Model.ExistingThumbnailImage" class="existing-img-preview" />
                                    <span class="existing-img-label">Current thumbnail</span>
                                </div>
                            }
                            <div class="file-upload-zone" style="margin-top:8px;">
                                <input type="file" name="ThumbnailFile" id="ThumbnailFile" accept="image/*" class="file-input-hidden" onchange="previewImage(this,'thumbPreview')" />
                                <div class="file-upload-inner" onclick="document.getElementById('ThumbnailFile').click()">
                                    <svg viewBox="0 0 24 24" width="22" height="22" fill="#9ca3af"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                                    <span>Replace thumbnail</span>
                                </div>
                                <img id="thumbPreview" src="#" alt="Preview" class="file-preview" style="display:none;" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Banner Image</label>
                            @if (!string.IsNullOrEmpty(Model.ExistingBannerImage))
                            {
                                <div class="existing-image-wrap">
                                    <img src="@Model.ExistingBannerImage" class="existing-img-preview" />
                                    <span class="existing-img-label">Current banner</span>
                                </div>
                            }
                            <div class="file-upload-zone" style="margin-top:8px;">
                                <input type="file" name="BannerFile" id="BannerFile" accept="image/*" class="file-input-hidden" onchange="previewImage(this,'bannerPreview')" />
                                <div class="file-upload-inner" onclick="document.getElementById('BannerFile').click()">
                                    <svg viewBox="0 0 24 24" width="22" height="22" fill="#9ca3af"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                                    <span>Replace banner</span>
                                </div>
                                <img id="bannerPreview" src="#" alt="Preview" class="file-preview" style="display:none;" />
                            </div>
                        </div>
                    </div>

                    @* Existing gallery images *@
                    @if (Model.ExistingGalleryImages != null && Model.ExistingGalleryImages.Any())
                    {
                        <div class="form-group">
                            <label class="form-label">Existing Gallery Images</label>
                            <div class="gallery-existing-grid" id="existingGallery">
                                @foreach (var img in Model.ExistingGalleryImages)
                                {
                                    <div class="gallery-existing-item" id="galItem_@img.ImageId">
                                        <img src="@img.ImagePath" alt="Gallery" />
                                        <button type="button" class="gallery-del-btn"
                                                onclick="deleteGalleryImage(@img.ImageId)"
                                                title="Remove image">&times;</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="form-group">
                        <label class="form-label">Add More Gallery Images</label>
                        <div class="file-upload-zone">
                            <input type="file" name="GalleryFiles" id="GalleryFiles" accept="image/*" multiple class="file-input-hidden" onchange="previewGallery(this)" />
                            <div class="file-upload-inner" onclick="document.getElementById('GalleryFiles').click()">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="#9ca3af"><path d="M22 16V4c0-1.1-.9-2-2-2H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2zM11 12l2.03 2.71L16 11l4 5H8l3-4zM2 6v14c0 1.1.9 2 2 2h14v-2H4V6H2z"/></svg>
                                <span>Select images to add to gallery</span>
                            </div>
                        </div>
                        <div id="galleryPreviews" style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;"></div>
                    </div>
                </div>
            </div>

            @* SECTION 5 — Description *@
            <div class="form-section">
                <div class="form-section-header">
                    <span class="form-section-num">5</span>
                    <h3 class="form-section-title">Description</h3>
                </div>
                <div class="form-section-body">
                    <div class="form-group">
                        @Html.LabelFor(m => m.ShortDescription, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.ShortDescription, new { @class = "form-control", rows = "3", maxlength = "1000" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", id = "Description", rows = "10" })
                    </div>
                </div>
            </div>

            @* SECTION 6 — Itinerary *@
            <div class="form-section">
                <div class="form-section-header">
                    <span class="form-section-num">6</span>
                    <h3 class="form-section-title">Itinerary</h3>
                    <button type="button" class="btn-add-row" onclick="addItineraryRow()">+ Add Day</button>
                </div>
                <div class="form-section-body" style="padding-top:0;">
                    <div class="itin-table-wrap">
                        <table class="itin-table" id="itineraryTable">
                            <thead>
                                <tr>
                                    <th style="width:70px;">Day</th>
                                    <th style="width:35%;">Title</th>
                                    <th>Description</th>
                                    <th style="width:46px;"></th>
                                </tr>
                            </thead>
                            <tbody id="itineraryBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* SECTION 7 — Inclusions *@
            <div class="form-section">
                <div class="form-section-header">
                    <span class="form-section-num">7</span>
                    <h3 class="form-section-title">Inclusions</h3>
                    <button type="button" class="btn-add-row green" onclick="addListItem('inclusionsList','incl-item')">+ Add Inclusion</button>
                </div>
                <div class="form-section-body" style="padding-top:8px;">
                    <div id="inclusionsList" class="dynamic-list"></div>
                </div>
            </div>

            @* SECTION 8 — Exclusions *@
            <div class="form-section">
                <div class="form-section-header">
                    <span class="form-section-num">8</span>
                    <h3 class="form-section-title">Exclusions</h3>
                    <button type="button" class="btn-add-row red" onclick="addListItem('exclusionsList','excl-item')">+ Add Exclusion</button>
                </div>
                <div class="form-section-body" style="padding-top:8px;">
                    <div id="exclusionsList" class="dynamic-list"></div>
                </div>
            </div>

        </div>@* /pkg-col-main *@

        @* ─── RIGHT COLUMN ────────────────────────────────────── *@
        <div class="pkg-col-side">

            @* SECTION 9 — Flags *@
            <div class="form-section">
                <div class="form-section-header">
                    <span class="form-section-num">9</span>
                    <h3 class="form-section-title">Flags & Settings</h3>
                </div>
                <div class="form-section-body">
                    <div class="toggle-row">
                        <div class="toggle-info">
                            <span class="toggle-label">Active</span>
                            <span class="toggle-hint">Visible on website</span>
                        </div>
                        <label class="toggle-switch">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "toggle-checkbox" })
                            <span class="toggle-thumb"></span>
                        </label>
                    </div>
                    <div class="toggle-row">
                        <div class="toggle-info">
                            <span class="toggle-label">Featured Package</span>
                            <span class="toggle-hint">Show in featured section</span>
                        </div>
                        <label class="toggle-switch">
                            @Html.CheckBoxFor(m => m.IsFeatured, new { @class = "toggle-checkbox" })
                            <span class="toggle-thumb"></span>
                        </label>
                    </div>
                    <div class="toggle-row">
                        <div class="toggle-info">
                            <span class="toggle-label">Popular Package</span>
                            <span class="toggle-hint">Show in popular section</span>
                        </div>
                        <label class="toggle-switch">
                            @Html.CheckBoxFor(m => m.IsPopular, new { @class = "toggle-checkbox" })
                            <span class="toggle-thumb"></span>
                        </label>
                    </div>
                    <div class="toggle-row">
                        <div class="toggle-info">
                            <span class="toggle-label">Flight Included</span>
                            <span class="toggle-hint">Show flight badge</span>
                        </div>
                        <label class="toggle-switch">
                            @Html.CheckBoxFor(m => m.IsFlightIncluded, new { @class = "toggle-checkbox" })
                            <span class="toggle-thumb"></span>
                        </label>
                    </div>
                    <div class="toggle-row">
                        <div class="toggle-info">
                            <span class="toggle-label">Visa Included</span>
                            <span class="toggle-hint">Show visa badge</span>
                        </div>
                        <label class="toggle-switch">
                            @Html.CheckBoxFor(m => m.IsVisaIncluded, new { @class = "toggle-checkbox" })
                            <span class="toggle-thumb"></span>
                        </label>
                    </div>
                    <div class="form-group" style="margin-top:14px;">
                        <label class="form-label">Display Order</label>
                        @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", type = "number", min = "0" })
                    </div>
                </div>
            </div>

            @* SECTION 10 — SEO *@
            <div class="form-section">
                <div class="form-section-header">
                    <span class="form-section-num">10</span>
                    <h3 class="form-section-title">SEO</h3>
                </div>
                <div class="form-section-body">
                    <div class="form-group">
                        @Html.LabelFor(m => m.MetaTitle, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.MetaTitle, new { @class = "form-control", maxlength = "300" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.MetaKeywords, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.MetaKeywords, new { @class = "form-control", maxlength = "500" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.MetaDescription, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.MetaDescription, new { @class = "form-control", rows = "4", maxlength = "1000" })
                    </div>
                </div>
            </div>

            @* Save Buttons *@
            <div class="form-section" style="background:transparent;border:none;box-shadow:none;padding:0;">
                <button type="submit" class="btn-primary-admin" style="width:100%;justify-content:center;padding:13px;">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" style="margin-right:6px;"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
                    Update Package
                </button>
                <a href="@Url.Action("Index")" class="btn-secondary-admin" style="width:100%;justify-content:center;margin-top:8px;">Cancel</a>
            </div>

        </div>@* /pkg-col-side *@

    </div>@* /pkg-form-grid *@
}

@* Hidden form for gallery delete CSRF *@
<form id="galleryDelForm" style="display:none;">@Html.AntiForgeryToken()</form>

@section scripts {
<script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
<script>
    tinymce.init({
        selector: '#Description',
        height: 380,
        menubar: false,
        plugins: 'lists link image code table',
        toolbar: 'undo redo | bold italic underline | bullist numlist | link | table | code',
        skin: 'oxide', content_css: 'default', branding: false
    });

    // Auto-slug (don't override if already set)
    var slugManual = ('@Model.Slug' !== '');
    document.getElementById('PackageName').addEventListener('input', function () {
        if (!slugManual) document.getElementById('Slug').value = slugify(this.value);
    });
    document.getElementById('Slug').addEventListener('input', function () {
        slugManual = this.value.length > 0;
        this.value = slugify(this.value);
    });
    function slugify(str) {
        return str.toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-').replace(/^-+|-+$/g,'');
    }

    function previewImage(input, previewId) {
        var preview = document.getElementById(previewId);
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
                preview.closest('.file-upload-zone').querySelector('.file-upload-inner').style.display = 'none';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function previewGallery(input) {
        var container = document.getElementById('galleryPreviews');
        container.innerHTML = '';
        Array.from(input.files).forEach(function (file) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var img = document.createElement('img');
                img.src = e.target.result;
                img.style.cssText = 'width:80px;height:60px;object-fit:cover;border-radius:6px;border:1px solid #e5e7eb;';
                container.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
    }

    // ── Delete gallery image via AJAX ─────────────────────────────
    function deleteGalleryImage(imageId) {
        if (!confirm('Remove this image?')) return;
        var token = document.querySelector('#galleryDelForm input[name="__RequestVerificationToken"]').value;
        fetch('@Url.Action("DeleteGalleryImage", "Packages")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: '__RequestVerificationToken=' + encodeURIComponent(token) + '&imageId=' + imageId
        })
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (d.success) {
                var el = document.getElementById('galItem_' + imageId);
                if (el) el.remove();
            }
        });
    }

    // ── Itinerary ──────────────────────────────────────────────────
    var itinData = @Html.Raw(Model.ItinerariesJson);

    function renderItinerary() {
        var tbody = document.getElementById('itineraryBody');
        if (!itinData.length) {
            tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:20px;color:#9ca3af;font-size:.85rem;">No itinerary entries. Click &ldquo;Add Day&rdquo; to begin.</td></tr>';
            return;
        }
        tbody.innerHTML = '';
        itinData.forEach(function (item, idx) {
            var tr = document.createElement('tr');
            tr.innerHTML =
                '<td><input type="number" class="form-control itin-day" min="1" value="' + (item.dayNumber||idx+1) + '" style="width:60px;" /></td>' +
                '<td><input type="text" class="form-control itin-title" value="' + escHtml(item.title||'') + '" placeholder="Title" /></td>' +
                '<td><textarea class="form-control itin-desc" rows="2" placeholder="Description…">' + escHtml(item.description||'') + '</textarea></td>' +
                '<td><button type="button" class="row-remove-btn" onclick="removeItinRow(this)">&#x2715;</button></td>';
            tbody.appendChild(tr);
        });
    }

    function addItineraryRow() {
        itinData.push({ dayNumber: itinData.length + 1, title: '', description: '' });
        renderItinerary();
        var rows = document.querySelectorAll('#itineraryBody tr');
        if (rows.length) rows[rows.length-1].querySelector('.itin-title').focus();
    }

    function removeItinRow(btn) {
        var idx = Array.from(document.querySelectorAll('#itineraryBody tr')).indexOf(btn.closest('tr'));
        itinData.splice(idx, 1);
        renderItinerary();
    }

    renderItinerary();

    // ── Pre-populate inclusions / exclusions ──────────────────────
    var initInclusions = @Html.Raw(Model.InclusionsJson);
    var initExclusions = @Html.Raw(Model.ExclusionsJson);

    function addListItem(listId, cssClass, value) {
        var list = document.getElementById(listId);
        var empty = list.querySelector('.list-empty');
        if (empty) empty.remove();
        var row = document.createElement('div');
        row.className = 'list-item-row';
        row.innerHTML =
            '<input type="text" class="form-control ' + cssClass + '" value="' + escHtml(value||'') + '" placeholder="Enter item…" />' +
            '<button type="button" class="row-remove-btn" onclick="this.closest(\'.list-item-row\').remove()">&#x2715;</button>';
        list.appendChild(row);
        if (!value) row.querySelector('input').focus();
    }

    initInclusions.forEach(function (v) { addListItem('inclusionsList','incl-item', v); });
    initExclusions.forEach(function (v) { addListItem('exclusionsList','excl-item', v); });

    // ── Serialize on submit ───────────────────────────────────────
    document.getElementById('packageForm').addEventListener('submit', function () {
        var itins = [];
        document.querySelectorAll('#itineraryBody tr').forEach(function (row) {
            var day = row.querySelector('.itin-day'), title = row.querySelector('.itin-title'), desc = row.querySelector('.itin-desc');
            if (title && title.value.trim()) itins.push({ dayNumber: parseInt(day?day.value:1)||1, title: title.value.trim(), description: desc?desc.value.trim():'' });
        });
        document.getElementById('ItinerariesJson').value = JSON.stringify(itins);
        document.getElementById('InclusionsJson').value = JSON.stringify(
            Array.from(document.querySelectorAll('.incl-item')).map(i=>i.value.trim()).filter(v=>v.length>0));
        document.getElementById('ExclusionsJson').value = JSON.stringify(
            Array.from(document.querySelectorAll('.excl-item')).map(i=>i.value.trim()).filter(v=>v.length>0));
        if (typeof tinymce !== 'undefined') tinymce.triggerSave();
    });

    function escHtml(str) {
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
</script>
}
