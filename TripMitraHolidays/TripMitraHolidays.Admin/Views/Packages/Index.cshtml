@model TripMitraHolidays.Core.ViewModels.PackageListViewModel
@using TripMitraHolidays.Core.Models
@{
    ViewBag.Title = "Packages";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@functions {
    string SortUrl(string col)
    {
        bool same = string.Equals(Model.SortColumn, col, System.StringComparison.OrdinalIgnoreCase);
        string d = same && Model.SortDir == "asc" ? "desc" : "asc";
        return Url.Action("Index", new { search = Model.Search, status = Model.StatusFilter, pageSize = Model.PageSize, sort = col, dir = d, page = 1 });
    }
    string SortClass(string col)
    {
        return string.Equals(Model.SortColumn, col, System.StringComparison.OrdinalIgnoreCase) ? "sort-active" : "";
    }
    System.Web.IHtmlString SortArrow(string col)
    {
        if (!string.Equals(Model.SortColumn, col, System.StringComparison.OrdinalIgnoreCase))
            return new System.Web.HtmlString("<i class=\"fa-solid fa-sort\"></i>");
        return new System.Web.HtmlString(Model.SortDir == "asc"
            ? "<i class=\"fa-solid fa-sort-up\"></i>"
            : "<i class=\"fa-solid fa-sort-down\"></i>");
    }
    string PageUrl(int p)
    {
        return Url.Action("Index", new { search = Model.Search, status = Model.StatusFilter, pageSize = Model.PageSize, sort = Model.SortColumn, dir = Model.SortDir, page = p });
    }
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
    <div>
        <h1>Packages</h1>
        <p>Manage all travel packages</p>
    </div>
    <a href="@Url.Action("Create")" class="btn-primary-admin">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" style="vertical-align:-2px;margin-right:6px;">
            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
        </svg>
        Add Package
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success-admin">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M9 16.2l-4.2-4.2-1.4 1.4 5.6 5.6 12-12-1.4-1.4z" /></svg>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-error-admin">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" /></svg>
        @TempData["Error"]
    </div>
}

<div class="admin-card" style="overflow:visible;">

    @* ── Card Header: title left, filters right ── *@
    <div class="pkg-list-header">
        <h2 class="admin-card-title" style="margin:0;white-space:nowrap;">All Packages</h2>
        @using (Html.BeginForm("Index", "Packages", FormMethod.Get, new { id = "filterForm" }))
        {
            <input type="hidden" name="sort" value="@Model.SortColumn" />
            <input type="hidden" name="dir" value="@Model.SortDir" />
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <div class="pkg-filter-row">
                <div class="pkg-filter-search">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="#9ca3af" class="filter-search-icon">
                        <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                    </svg>
                    <input type="text" name="search" value="@Model.Search"
                           placeholder="Search name, destination…" class="pkg-filter-input" />
                </div>
                <select name="status" class="pkg-filter-select">
                    <option value="all" @(Model.StatusFilter == "all" ? "selected" : "")>All Status</option>
                    <option value="active" @(Model.StatusFilter == "active" ? "selected" : "")>Active</option>
                    <option value="inactive" @(Model.StatusFilter == "inactive" ? "selected" : "")>Inactive</option>
                </select>
                <button type="submit" class="pkg-filter-btn">Apply</button>
                <a href="@Url.Action("Index")" class="pkg-filter-reset">Reset</a>
            </div>
        }
    </div>

    @* ── Table ── *@
    <div style="overflow-x:auto;">
        <table class="admin-table" id="packagesTable">
            <thead>
                <tr>
                    <th style="width:70px;">Image</th>
                    <th class="sort-th @SortClass("packagename")">
                        <a href="@SortUrl("packagename")" class="sort-link">Package Name <span class="sort-arrow">@SortArrow("packagename")</span></a>
                    </th>
                    <th class="sort-th @SortClass("destination")">
                        <a href="@SortUrl("destination")" class="sort-link">Destination <span class="sort-arrow">@SortArrow("destination")</span></a>
                    </th>
                    <th class="sort-th @SortClass("packageprice")">
                        <a href="@SortUrl("packageprice")" class="sort-link">Price <span class="sort-arrow">@SortArrow("packageprice")</span></a>
                    </th>
                    <th class="sort-th @SortClass("durationdays")">
                        <a href="@SortUrl("durationdays")" class="sort-link">Duration <span class="sort-arrow">@SortArrow("durationdays")</span></a>
                    </th>
                    <th>Tags</th>
                    <th class="sort-th @SortClass("isactive")">
                        <a href="@SortUrl("isactive")" class="sort-link">Status <span class="sort-arrow">@SortArrow("isactive")</span></a>
                    </th>
                    <th style="width:140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Packages.Any())
                {
                    <tr>
                        <td colspan="8" style="text-align:center;padding:48px 16px;color:#9ca3af;font-size:0.88rem;">
                            No packages found.
                            @if (!string.IsNullOrEmpty(Model.Search) || Model.StatusFilter != "all")
                            {
                                <a href="@Url.Action("Index")" style="color:var(--navy);font-weight:600;">Clear filters →</a>
                            }
                            else
                            {
                                <a href="@Url.Action("Create")" style="color:var(--navy);font-weight:600;">Add the first one →</a>
                            }
                        </td>
                    </tr>
                }
                @foreach (var pkg in Model.Packages)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(pkg.ThumbnailImage))
                            {
                                <img src="@pkg.ThumbnailImage" alt="@pkg.PackageName"
                                     style="width:54px;height:40px;object-fit:cover;border-radius:6px;border:1px solid #e5e7eb;" />
                            }
                            else
                            {
                                <div style="width:54px;height:40px;background:#f0f4fb;border-radius:6px;display:flex;align-items:center;justify-content:center;">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="#cbd5e1"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" /></svg>
                                </div>
                            }
                        </td>
                        <td>
                            <div style="font-weight:600;color:#111827;font-size:.875rem;">@pkg.PackageName</div>
                            <div style="font-size:.75rem;color:#9ca3af;margin-top:2px;">@pkg.PackageType &bull; @pkg.TourCategory</div>
                        </td>
                        <td>
                            <div style="font-size:.875rem;">@pkg.Destination</div>
                            <div style="font-size:.75rem;color:#9ca3af;">@pkg.Country</div>
                        </td>
                        <td>
                            @if (pkg.DiscountPrice.HasValue && pkg.DiscountPrice < pkg.PackagePrice)
                            {
                                <div style="font-weight:700;color:#059669;font-size:.875rem;"><i class="fa-solid fa-indian-rupee-sign"></i>@pkg.DiscountPrice.Value.ToString("N0")</div>
                                <div style="font-size:.73rem;color:#9ca3af;text-decoration:line-through;"><i class="fa-solid fa-indian-rupee-sign"></i>@pkg.PackagePrice.ToString("N0")</div>
                            }
                            else
                            {
                                <div style="font-weight:600;font-size:.875rem;"><i class="fa-solid fa-indian-rupee-sign"></i>@pkg.PackagePrice.ToString("N0")</div>
                            }
                        </td>
                        <td style="white-space:nowrap;font-size:.875rem;">@pkg.DurationDays D / @pkg.DurationNights N</td>
                        <td>
                            <div style="display:flex;gap:4px;flex-wrap:wrap;">
                                @if (pkg.IsFeatured)
                                {<span class="pkg-tag gold">Featured</span>}
                                @if (pkg.IsPopular)
                                {<span class="pkg-tag purple">Popular</span>}
                                @if (pkg.IsFlightIncluded)
                                {<span class="pkg-tag blue">Flight</span>}
                            </div>
                        </td>
                        <td>
                            <span class="badge-status @(pkg.IsActive ? "active" : "inactive")">
                                @(pkg.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <div style="display:flex;gap:5px;align-items:center;">
                                <a href="@Url.Action("Edit", new { id = pkg.PackageId })" class="tbl-btn edit" title="Edit">
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                                </a>
                                <a href="@Url.Action("Details", new { id = pkg.PackageId })" class="tbl-btn view" title="View">
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                                </a>
                                <button type="button"
                                        class="tbl-btn @(pkg.IsActive ? "deactivate" : "activate")"
                                        onclick="toggleActive(@pkg.PackageId, this)"
                                        title="@(pkg.IsActive ? "Deactivate" : "Activate")">
                                    @if (pkg.IsActive)
                                    {
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-4.42 3.58-8 8-8 1.85 0 3.55.63 4.9 1.68L5.68 16.9C4.63 15.55 4 13.85 4 12zm8 8c-1.85 0-3.55-.63-4.9-1.68l11.22-11.22C19.37 8.45 20 10.15 20 12c0 4.42-3.58 8-8 8z"/></svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M9 16.2l-4.2-4.2-1.4 1.4 5.6 5.6 12-12-1.4-1.4z"/></svg>
                                    }
                                </button>
                                @using (Html.BeginForm("Delete", "Packages", new { id = pkg.PackageId }, FormMethod.Post, new { style = "display:inline;", onsubmit = "return confirm('Delete this package? This cannot be undone.');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="tbl-btn delete" title="Delete">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Footer: showing info + page size + pagination ── *@
    <div class="pkg-list-footer">
        <div class="pkg-footer-left">
            @if (Model.TotalCount > 0)
            {
                <span class="pkg-showing-text">
                    Showing <strong>@Model.StartRecord</strong>&ndash;<strong>@Model.EndRecord</strong>
                    of <strong>@Model.TotalCount</strong> package@(Model.TotalCount == 1 ? "" : "s")
                </span>
            }
            else
            {
                <span class="pkg-showing-text">No packages found</span>
            }
            <select id="pageSizeSelect" class="pkg-pagesize-select">
                @foreach (var sz in new[] { 10, 25, 50, 100 })
                {
                    <option value="@sz" @(Model.PageSize == sz ? "selected" : "")>@sz / page</option>
                }
            </select>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="pkg-pagination">
                @if (Model.HasPrev)
                {
                    <a href="@PageUrl(Model.Page - 1)" class="pg-btn">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z" /></svg>
                    </a>
                }
                else
                {
                    <span class="pg-btn disabled"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z" /></svg></span>
                }
                @{
                    int tp = Model.TotalPages;
                    int cp = Model.Page;
                    var pageNums = new System.Collections.Generic.List<int>();
                    for (int pi = 1; pi <= tp; pi++)
                    {
                        if (pi == 1 || pi == tp || (pi >= cp - 2 && pi <= cp + 2))
                        {
                            pageNums.Add(pi);
                        }
                    }
                    int prevNum = 0;
                    foreach (int pi in pageNums)
                    {
                        if (prevNum > 0 && pi - prevNum > 1)
                        { <span class="pg-ellipsis">..</span> }
                        if (pi == cp)
                        { <span class="pg-btn active">@pi</span> }
                    else
                    { <a href="@PageUrl(pi)" class="pg-btn">@pi</a> }
                prevNum = pi;
            }
                }
                @if (Model.HasNext)
                {
                    <a href="@PageUrl(Model.Page + 1)" class="pg-btn">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z" /></svg>
                    </a>
                }
                else
                {
                    <span class="pg-btn disabled"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z" /></svg></span>
                }
            </div>
        }
    </div>
</div>

<form id="toggleForm" style="display:none;">@Html.AntiForgeryToken()</form>

@section scripts {
    <script>
    // Page size change → immediate reload at page 1
    document.getElementById('pageSizeSelect').addEventListener('change', function () {
        var params = new URLSearchParams(window.location.search);
        params.set('pageSize', this.value);
        params.set('page', '1');
        window.location.href = window.location.pathname + '?' + params.toString();
    });

    var ICON_DEACTIVATE = '<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-4.42 3.58-8 8-8 1.85 0 3.55.63 4.9 1.68L5.68 16.9C4.63 15.55 4 13.85 4 12zm8 8c-1.85 0-3.55-.63-4.9-1.68l11.22-11.22C19.37 8.45 20 10.15 20 12c0 4.42-3.58 8-8 8z"/></svg>';
    var ICON_ACTIVATE   = '<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M9 16.2l-4.2-4.2-1.4 1.4 5.6 5.6 12-12-1.4-1.4z"/></svg>';

    // Toggle active via AJAX
    function toggleActive(id, btn) {
        var token = document.querySelector('#toggleForm input[name="__RequestVerificationToken"]').value;
        fetch('@Url.Action("ToggleActive", "Packages")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: '__RequestVerificationToken=' + encodeURIComponent(token) + '&id=' + id
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.success) {
                var isActive = data.isActive;
                var badge = btn.closest('tr').querySelector('.badge-status');
                badge.className = 'badge-status ' + (isActive ? 'active' : 'inactive');
                badge.textContent = isActive ? 'Active' : 'Inactive';
                btn.className = 'tbl-btn ' + (isActive ? 'deactivate' : 'activate');
                btn.innerHTML = isActive ? ICON_DEACTIVATE : ICON_ACTIVATE;
                btn.title     = isActive ? 'Deactivate' : 'Activate';
            }
        });
    }
    </script>
}
