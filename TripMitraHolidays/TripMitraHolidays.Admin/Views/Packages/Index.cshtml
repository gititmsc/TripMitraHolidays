@model List<TripMitraHolidays.Core.Models.Package>
@{
    ViewBag.Title = "Packages";
    ViewBag.PageTitle = "Packages";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
    <div>
        <h1>Packages</h1>
        <p>Manage all travel packages</p>
    </div>
    <a href="@Url.Action("Create")" class="btn-primary-admin">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" style="vertical-align:-2px;margin-right:6px;">
            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
        </svg>
        Add Package
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success-admin">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M9 16.2l-4.2-4.2-1.4 1.4 5.6 5.6 12-12-1.4-1.4z"/></svg>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-error-admin">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
        @TempData["Error"]
    </div>
}

<div class="admin-card" style="overflow:visible;">
    <div class="admin-card-header">
        <h2 class="admin-card-title">All Packages (@Model.Count)</h2>
        <input type="text" id="pkgSearch" placeholder="Search packages…" style="border:1.5px solid #e5e7eb;border-radius:8px;padding:6px 12px;font-size:0.83rem;outline:none;width:220px;" />
    </div>
    <div class="admin-card-body" style="padding:0;overflow-x:auto;">
        <table class="admin-table" id="packagesTable">
            <thead>
                <tr>
                    <th style="width:70px;">Image</th>
                    <th>Package Name</th>
                    <th>Destination</th>
                    <th>Price</th>
                    <th>Duration</th>
                    <th>Tags</th>
                    <th>Status</th>
                    <th style="width:180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" style="text-align:center;padding:48px 16px;color:#9ca3af;font-size:0.88rem;">
                            No packages found. <a href="@Url.Action("Create")" style="color:var(--navy);font-weight:600;">Add the first one →</a>
                        </td>
                    </tr>
                }
                @foreach (var pkg in Model)
                {
                    <tr data-name="@pkg.PackageName.ToLower()" data-dest="@(pkg.Destination ?? "").ToLower()">
                        <td>
                            @if (!string.IsNullOrEmpty(pkg.ThumbnailImage))
                            {
                                <img src="@pkg.ThumbnailImage" alt="@pkg.PackageName"
                                     style="width:54px;height:40px;object-fit:cover;border-radius:6px;border:1px solid #e5e7eb;" />
                            }
                            else
                            {
                                <div style="width:54px;height:40px;background:#f0f4fb;border-radius:6px;display:flex;align-items:center;justify-content:center;">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="#cbd5e1"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                                </div>
                            }
                        </td>
                        <td>
                            <div style="font-weight:600;color:#111827;font-size:.875rem;">@pkg.PackageName</div>
                            <div style="font-size:.75rem;color:#9ca3af;margin-top:2px;">@pkg.PackageType &bull; @pkg.TourCategory</div>
                        </td>
                        <td>
                            <div style="font-size:.875rem;">@pkg.Destination</div>
                            <div style="font-size:.75rem;color:#9ca3af;">@pkg.Country</div>
                        </td>
                        <td>
                            @if (pkg.DiscountPrice.HasValue && pkg.DiscountPrice < pkg.PackagePrice)
                            {
                                <div style="font-weight:700;color:#059669;font-size:.875rem;">&#x20B9;@pkg.DiscountPrice.Value.ToString("N0")</div>
                                <div style="font-size:.73rem;color:#9ca3af;text-decoration:line-through;">&#x20B9;@pkg.PackagePrice.ToString("N0")</div>
                            }
                            else
                            {
                                <div style="font-weight:600;font-size:.875rem;">&#x20B9;@pkg.PackagePrice.ToString("N0")</div>
                            }
                        </td>
                        <td style="white-space:nowrap;font-size:.875rem;">
                            @pkg.DurationDays D / @pkg.DurationNights N
                        </td>
                        <td>
                            <div style="display:flex;gap:4px;flex-wrap:wrap;">
                                @if (pkg.IsFeatured)
                                {
                                    <span class="pkg-tag gold">Featured</span>
                                }
                                @if (pkg.IsPopular)
                                {
                                    <span class="pkg-tag purple">Popular</span>
                                }
                                @if (pkg.IsFlightIncluded)
                                {
                                    <span class="pkg-tag blue">Flight</span>
                                }
                            </div>
                        </td>
                        <td>
                            <span class="badge-status @(pkg.IsActive ? "active" : "inactive")">
                                @(pkg.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                <a href="@Url.Action("Edit", new { id = pkg.PackageId })" class="tbl-btn edit" title="Edit">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                                    Edit
                                </a>
                                <a href="@Url.Action("Details", new { id = pkg.PackageId })" class="tbl-btn view" title="View">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                                    View
                                </a>
                                <button type="button"
                                        class="tbl-btn @(pkg.IsActive ? "deactivate" : "activate")"
                                        data-id="@pkg.PackageId"
                                        data-active="@pkg.IsActive.ToString().ToLower()"
                                        onclick="toggleActive(@pkg.PackageId, this)"
                                        title="@(pkg.IsActive ? "Deactivate" : "Activate")">
                                    @(pkg.IsActive ? "Deactivate" : "Activate")
                                </button>
                                @using (Html.BeginForm("Delete", "Packages", new { id = pkg.PackageId }, FormMethod.Post, new { style = "display:inline;", onsubmit = "return confirm('Delete this package? This cannot be undone.');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="tbl-btn delete" title="Delete">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                                        Delete
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Hidden form for toggle active CSRF *@
<form id="toggleForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section scripts {
<script>
    // Search filter
    document.getElementById('pkgSearch').addEventListener('input', function () {
        var q = this.value.toLowerCase();
        document.querySelectorAll('#packagesTable tbody tr[data-name]').forEach(function (row) {
            var name = row.getAttribute('data-name') || '';
            var dest = row.getAttribute('data-dest') || '';
            row.style.display = (name.includes(q) || dest.includes(q)) ? '' : 'none';
        });
    });

    // Toggle active via AJAX
    function toggleActive(id, btn) {
        var token = document.querySelector('#toggleForm input[name="__RequestVerificationToken"]').value;
        fetch('@Url.Action("ToggleActive", "Packages")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: '__RequestVerificationToken=' + encodeURIComponent(token) + '&id=' + id
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.success) {
                var isActive = data.isActive;
                var badge = btn.closest('tr').querySelector('.badge-status');
                badge.className = 'badge-status ' + (isActive ? 'active' : 'inactive');
                badge.textContent = isActive ? 'Active' : 'Inactive';
                btn.className = 'tbl-btn ' + (isActive ? 'deactivate' : 'activate');
                btn.textContent = isActive ? 'Deactivate' : 'Activate';
            }
        });
    }
</script>
}
