<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Trip Mitra Admin</title>
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="~/Content/admin.css" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="admin-body">
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var userEmail = User.Identity.IsAuthenticated ? User.Identity.Name : "Admin";
    var userInitial = string.IsNullOrEmpty(userEmail) ? "A" : userEmail.Substring(0, 1).ToUpper();
}

<div class="admin-wrapper" id="adminWrapper">

    @* ── Mobile overlay ── *@
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    @* ══════════════════════════════
       SIDEBAR
       ══════════════════════════════ *@
    <aside class="sidebar" id="sidebar">

        @* Logo *@
        <div class="sidebar-header">
            <a href="@Url.Action("Index", "Dashboard")">
                <img src="~/Content/images/logo.png" alt="Trip Mitra Holidays" class="sidebar-logo" />
            </a>
        </div>

        @* Navigation *@
        <nav class="sidebar-nav">

            <span class="nav-section-label">Main</span>

            <a href="@Url.Action("Index", "Dashboard")"
               class="nav-item @(currentController == "Dashboard" ? "active" : "")">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
                </svg>
                Dashboard
            </a>

            <span class="nav-section-label">Management</span>

            <a href="@Url.Action("Index", "Users")"
               class="nav-item @(currentController == "Users" ? "active" : "")">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                </svg>
                Users
            </a>

            <a href="@Url.Action("Index", "Packages")"
               class="nav-item @(currentController == "Packages" ? "active" : "")">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 6h-2.18c.07-.44.18-.88.18-1.36C18 2.53 15.47 0 12.36 0c-1.73 0-3.24.88-4.14 2.2L12 6H20zm-8.84 0l-3.44-4.47A5.02 5.02 0 0 0 6 4.64c0 .48.08.92.18 1.36H4C2.9 6 2 6.9 2 8v2c0 1.1.9 2 2 2h.44l1.44 7.22A2 2 0 0 0 7.85 21h8.3c.96 0 1.8-.68 1.97-1.63L19.56 12H20c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2H11.16z"/>
                </svg>
                Packages
            </a>

            <a href="@Url.Action("Index", "Enquiries")"
               class="nav-item @(currentController == "Enquiries" ? "active" : "")">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/>
                </svg>
                Enquiries
            </a>

        </nav>

        <div class="sidebar-footer">
            &copy; @DateTime.Now.Year Trip Mitra Holidays
        </div>
    </aside>

    @* ══════════════════════════════
       MAIN AREA
       ══════════════════════════════ *@
    <div class="main-area" id="mainArea">

        @* ── Topbar ── *@
        <header class="topbar">
            <div class="topbar-left">
                <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle menu" type="button">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
                    </svg>
                </button>
                <span class="topbar-page-title d-none d-md-block">@ViewBag.PageTitle</span>
            </div>

            <div class="topbar-right">
                @* Hidden logout form — submitted by JS *@
                @using (Html.BeginForm("Logout", "Account", FormMethod.Post,
                        new { id = "logoutForm", style = "display:none;" }))
                {
                    @Html.AntiForgeryToken()
                }

                @* Profile button *@
                <div class="profile-wrap" id="profileWrap">
                    <div class="profile-avatar">@userInitial</div>
                    <div class="profile-info d-none d-md-block">
                        <div class="profile-name">@userEmail</div>
                        <div class="profile-role">Administrator</div>
                    </div>
                    <svg class="profile-caret" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7 10l5 5 5-5z"/>
                    </svg>

                    @* Dropdown *@
                    <div class="profile-dropdown" id="profileDropdown">
                        <div class="dropdown-user-section">
                            <div class="dropdown-avatar">@userInitial</div>
                            <div class="dropdown-user-email">@userEmail</div>
                        </div>
                        <a href="#" class="dropdown-item-link logout"
                           onclick="document.getElementById('logoutForm').submit(); return false;">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5-5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
                            </svg>
                            Log Out
                        </a>
                    </div>
                </div>
            </div>
        </header>

        @* ── Page body ── *@
        <main class="page-content">
            @RenderBody()
        </main>

    </div>@* /main-area *@

</div>@* /admin-wrapper *@

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")
@RenderSection("scripts", required: false)

<script>
    (function () {
        var wrapper = document.getElementById('adminWrapper');
        var overlay = document.getElementById('sidebarOverlay');
        var toggleBtn = document.getElementById('sidebarToggle');
        var profileWrap = document.getElementById('profileWrap');
        var profileDropdown = document.getElementById('profileDropdown');

        // Sidebar toggle
        toggleBtn.addEventListener('click', function () {
            if (window.innerWidth >= 992) {
                wrapper.classList.toggle('sidebar-collapsed');
            } else {
                wrapper.classList.toggle('sidebar-open');
            }
        });

        // Close sidebar on overlay click (mobile)
        overlay.addEventListener('click', function () {
            wrapper.classList.remove('sidebar-open');
        });

        // Profile dropdown toggle
        profileWrap.addEventListener('click', function (e) {
            e.stopPropagation();
            var isOpen = profileDropdown.classList.toggle('show');
            profileWrap.classList.toggle('open', isOpen);
        });

        // Close dropdown on outside click
        document.addEventListener('click', function () {
            profileDropdown.classList.remove('show');
            profileWrap.classList.remove('open');
        });

        // Close sidebar on resize to desktop
        window.addEventListener('resize', function () {
            if (window.innerWidth >= 992) {
                wrapper.classList.remove('sidebar-open');
            }
        });
    })();
</script>
</body>
</html>
