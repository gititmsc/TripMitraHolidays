@model TripMitraHolidays.Core.ViewModels.LoginViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewBag.Title = "Sign In";
}

<div class="login-page">
    <div class="login-wrapper">

        @* Logo *@
        <div class="login-logo-wrap">
            <img src="~/Content/images/logo.png" alt="Trip Mitra Holidays" />
        </div>

        @* Login Card *@
        <div class="login-card">

            <div class="login-card-header">
                <h2>Admin Portal</h2>
                <p class="login-subtitle">Sign in to your admin account</p>
            </div>

            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-validation-summary">
                        @Html.ValidationSummary(true)
                    </div>
                }

                @* Email *@
                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                    <div class="input-group">
                        <span class="input-group-text login-input-icon">
                            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z" />
                            </svg>
                        </span>
                        @Html.TextBoxFor(m => m.Email, new {
                            @class = "form-control",
                            placeholder = "admin@tripmitra.com",
                            autocomplete = "username",
                            type = "email"
                        })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
                </div>

                @* Password *@
                <div class="mb-4">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                    <div class="input-group">
                        <span class="input-group-text login-input-icon">
                            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                <path d="M18 8h-1V6A5 5 0 0 0 7 6v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2zm-6 9a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm3.1-9H8.9V6a3.1 3.1 0 0 1 6.2 0v2z" />
                            </svg>
                        </span>
                        @Html.PasswordFor(m => m.Password, new {
                            @class = "form-control has-toggle",
                            placeholder = "••••••••",
                            id = "passwordField",
                            autocomplete = "current-password"
                        })
                        <button type="button" class="btn-toggle-password" id="togglePassword" aria-label="Show or hide password">
                            <svg id="iconEye" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                            </svg>
                            <svg id="iconEyeOff" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="display:none;">
                                <path d="M12 7a5 5 0 0 1 5 5c0 .64-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75C21.27 7.11 17 4 12 4c-1.27 0-2.49.2-3.64.57l2.17 2.17C11 6.63 11.5 7 12 7zm-9.9-.97 2.54 2.54-.01.01A11.9 11.9 0 0 0 2 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42 2.93 2.92 1.27-1.27L3.37 5.76 2.1 6.03zM7 12a5 5 0 0 0 5 5c.95 0 1.84-.28 2.59-.75l-1.49-1.49A3 3 0 0 1 9 12c0-.35.07-.68.18-1L7.5 9.33A4.96 4.96 0 0 0 7 12z" />
                            </svg>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                </div>

                @* Remember me & Forgot password *@
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.RememberMe, "Remember me", new { @class = "form-check-label" })
                    </div>
                    <a href="#" class="forgot-link">Forgot password?</a>
                </div>

                @* Submit *@
                <button type="submit" class="btn btn-login w-100">
                    Sign In
                    <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" />
                    </svg>
                </button>
            }
        </div>

        <p class="login-copyright">
            &copy; @DateTime.Now.Year Trip Mitra Holidays. All rights reserved.
        </p>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var btn = document.getElementById('togglePassword');
            var field = document.getElementById('passwordField');
            var iconEye = document.getElementById('iconEye');
            var iconEyeOff = document.getElementById('iconEyeOff');

            if (btn && field) {
                btn.addEventListener('click', function () {
                    var isPassword = field.type === 'password';
                    field.type = isPassword ? 'text' : 'password';
                    iconEye.style.display = isPassword ? 'none' : '';
                    iconEyeOff.style.display = isPassword ? '' : 'none';
                });
            }
        })();
    </script>
}
