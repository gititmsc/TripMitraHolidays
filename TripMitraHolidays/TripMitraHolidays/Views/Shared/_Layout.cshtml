<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* ── SEO: Title ── *@
    <title>@(ViewBag.MetaTitle ?? "Trip Mitra Holidays – Explore More, Worry Less")</title>

    @* ── SEO: Meta tags ── *@
    @if (!string.IsNullOrEmpty(ViewBag.MetaDescription as string))
    {
        <meta name="description" content="@ViewBag.MetaDescription" />
    }
    @if (!string.IsNullOrEmpty(ViewBag.MetaKeywords as string))
    {
        <meta name="keywords" content="@ViewBag.MetaKeywords" />
    }

    @* ── SEO: Canonical ── *@
    @if (!string.IsNullOrEmpty(ViewBag.CanonicalUrl as string))
    {
        <link rel="canonical" href="@ViewBag.CanonicalUrl" />
    }

    @* ── OpenGraph tags ── *@
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trip Mitra Holidays" />
    <meta property="og:title" content="@(ViewBag.MetaTitle ?? "Trip Mitra Holidays – Explore More, Worry Less")" />
    @if (!string.IsNullOrEmpty(ViewBag.MetaDescription as string))
    {
        <meta property="og:description" content="@ViewBag.MetaDescription" />
    }
    @if (!string.IsNullOrEmpty(ViewBag.OgImage as string))
    {
        <meta property="og:image" content="@ViewBag.OgImage" />
    }

    @* ── Twitter Card ── *@
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewBag.MetaTitle ?? "Trip Mitra Holidays")" />
    @if (!string.IsNullOrEmpty(ViewBag.MetaDescription as string))
    {
        <meta name="twitter:description" content="@ViewBag.MetaDescription" />
    }

    @* ── Google Fonts ── *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    @* ── Font Awesome 6 ── *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plh7eqAAHA/24pvKBR8Ot8slFGP0QQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    @* ── Trip Mitra CSS ── *@
    @Styles.Render("~/Content/tripmitra")
    <script src="~/Scripts/fontawesome.js" crossorigin="anonymous"></script>
</head>
<body>

<div class="page-wrap">

    @Html.Partial("_Topbar")
    @Html.Partial("_Navbar")

    @RenderBody()

    @Html.Partial("_Footer")

</div>@* /page-wrap *@

@Html.Partial("_WhatsApp")

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/tripmitra")
@RenderSection("scripts", required: false)

</body>
</html>
