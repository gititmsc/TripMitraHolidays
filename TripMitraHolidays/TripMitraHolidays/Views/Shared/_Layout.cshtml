<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* ── SEO: Title ── *@
    <title>@(ViewBag.MetaTitle ?? "TripMitra Holidays – Explore More, Worry Less")</title>

    @* ── SEO: Meta tags ── *@
    @if (!string.IsNullOrEmpty(ViewBag.MetaDescription as string))
    {
        <meta name="description" content="@ViewBag.MetaDescription" />
    }
    @if (!string.IsNullOrEmpty(ViewBag.MetaKeywords as string))
    {
        <meta name="keywords" content="@ViewBag.MetaKeywords" />
    }

    @* ── SEO: Canonical ── *@
    @if (!string.IsNullOrEmpty(ViewBag.CanonicalUrl as string))
    {
        <link rel="canonical" href="@ViewBag.CanonicalUrl" />
    }

    @* ── OpenGraph tags ── *@
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TripMitra Holidays" />
    <meta property="og:title" content="@(ViewBag.MetaTitle ?? "TripMitra Holidays – Explore More, Worry Less")" />
    @if (!string.IsNullOrEmpty(ViewBag.MetaDescription as string))
    {
        <meta property="og:description" content="@ViewBag.MetaDescription" />
    }
    @if (!string.IsNullOrEmpty(ViewBag.OgImage as string))
    {
        <meta property="og:image" content="@ViewBag.OgImage" />
    }

    @* ── Twitter Card ── *@
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewBag.MetaTitle ?? "TripMitra Holidays")" />
    @if (!string.IsNullOrEmpty(ViewBag.MetaDescription as string))
    {
        <meta name="twitter:description" content="@ViewBag.MetaDescription" />
    }

    @* ── Google Fonts ── *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    @* ── TripMitra CSS ── *@
    @Styles.Render("~/Content/tripmitra")
</head>
<body>

<div class="page-wrap">

    @Html.Partial("_Topbar")
    @Html.Partial("_Navbar")

    @RenderBody()

    @Html.Partial("_Footer")

</div>@* /page-wrap *@

@Html.Partial("_WhatsApp")

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/tripmitra")
@RenderSection("scripts", required: false)

</body>
</html>
