@using System.Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* ── SEO: Title ── *@
    <title>@(ViewBag.MetaTitle ?? "Trip Mitra Holidays – Explore More, Worry Less")</title>

    @* ── Search-engine ownership verification ── *@
    @{
        string googleVerify = ConfigurationManager.AppSettings["GoogleSiteVerification"];
        string bingVerify   = ConfigurationManager.AppSettings["BingSiteVerification"];
    }
    @if (!string.IsNullOrEmpty(googleVerify))
    {
        <meta name="google-site-verification" content="@googleVerify" />
    }
    @if (!string.IsNullOrEmpty(bingVerify))
    {
        <meta name="msvalidate.01" content="@bingVerify" />
    }

    @* ── Google Analytics 4 — set GoogleAnalyticsId in web.config to enable ── *@
    @{ string gaId = ConfigurationManager.AppSettings["GoogleAnalyticsId"]; }
    @if (!string.IsNullOrEmpty(gaId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', '@gaId');
        </script>
    }

    @* ── SEO: Meta tags ── *@
    @if (!string.IsNullOrEmpty(ViewBag.MetaDescription as string))
    {
        <meta name="description" content="@ViewBag.MetaDescription" />
    }
    @if (!string.IsNullOrEmpty(ViewBag.MetaKeywords as string))
    {
        <meta name="keywords" content="@ViewBag.MetaKeywords" />
    }

    @* ── SEO: Canonical ── *@
    @if (!string.IsNullOrEmpty(ViewBag.CanonicalUrl as string))
    {
        <link rel="canonical" href="@ViewBag.CanonicalUrl" />
    }

    @* ── OpenGraph tags ── *@
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trip Mitra Holidays" />
    <meta property="og:title" content="@(ViewBag.MetaTitle ?? "Trip Mitra Holidays – Explore More, Worry Less")" />
    @if (!string.IsNullOrEmpty(ViewBag.MetaDescription as string))
    {
        <meta property="og:description" content="@ViewBag.MetaDescription" />
    }
    @if (!string.IsNullOrEmpty(ViewBag.OgImage as string))
    {
        <meta property="og:image" content="@ViewBag.OgImage" />
    }

    @* ── Twitter Card ── *@
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewBag.MetaTitle ?? "Trip Mitra Holidays")" />
    @if (!string.IsNullOrEmpty(ViewBag.MetaDescription as string))
    {
        <meta name="twitter:description" content="@ViewBag.MetaDescription" />
    }

    @* ── Google Fonts ── *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    @* ── Font Awesome 6 ── *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plh7eqAAHA/24pvKBR8Ot8slFGP0QQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    @* ── Trip Mitra CSS ── *@
    @Styles.Render("~/Content/tripmitra")
    <script src="~/Scripts/fontawesome.js" crossorigin="anonymous"></script>

    @* ── SEO: TravelAgency / LocalBusiness structured data — sitewide, one source of truth ── *@
    @{
        string siteDomain = ConfigurationManager.AppSettings["CanonicalDomain"];
        if (string.IsNullOrEmpty(siteDomain)) siteDomain = Request.Url?.Authority ?? "www.tripmitraholidays.com";
        string siteUrl  = "https://" + siteDomain + "/";
        string siteLogo = "https://" + siteDomain + "/Content/images/logo.png";

        var socialLinks = new[]
        {
            ConfigurationManager.AppSettings["SocialFacebookUrl"],
            ConfigurationManager.AppSettings["SocialInstagramUrl"],
            ConfigurationManager.AppSettings["SocialTwitterUrl"],
            ConfigurationManager.AppSettings["SocialYoutubeUrl"]
        }.Where(s => !string.IsNullOrEmpty(s)).ToArray();

        string officeAddress = ConfigurationManager.AppSettings["OfficeAddress"];

        var orgSchemaObj = new Dictionary<string, object>();
        orgSchemaObj.Add("context", "https://schema.org");
        orgSchemaObj.Add("type", "TravelAgency");
        orgSchemaObj.Add("name", "Trip Mitra Holidays");
        orgSchemaObj.Add("url", siteUrl);
        orgSchemaObj.Add("logo", siteLogo);
        orgSchemaObj.Add("image", siteLogo);
        orgSchemaObj.Add("description", "Trip Mitra Holidays offers handpicked domestic and international holiday packages with expert planning and 24/7 support.");
        orgSchemaObj.Add("telephone", ConfigurationManager.AppSettings["CompanyPhoneE164"]);
        orgSchemaObj.Add("email", ConfigurationManager.AppSettings["CompanyEmail"]);
        if (!string.IsNullOrEmpty(officeAddress))
        {
            var addressObj = new Dictionary<string, object>();
            addressObj.Add("type", "PostalAddress");
            addressObj.Add("streetAddress", officeAddress);
            addressObj.Add("addressCountry", "IN");
            orgSchemaObj.Add("address", addressObj);
        }
        if (socialLinks.Any())
        {
            orgSchemaObj.Add("sameAs", socialLinks);
        }

        string orgSchemaJson = System.Web.Helpers.Json.Encode(orgSchemaObj)
            .Replace("\"context\"", "\"@context\"")
            .Replace("\"type\"", "\"@type\"");
    }
    <script type="application/ld+json">
        @Html.Raw(orgSchemaJson)
    </script>
    @RenderSection("structuredData", required: false)
</head>
<body>

<div class="page-wrap">

    @Html.Partial("_Topbar")
    @Html.Partial("_Navbar")

    @RenderBody()

    @Html.Partial("_Footer")

</div>@* /page-wrap *@

@Html.Partial("_WhatsApp")

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/tripmitra")
@RenderSection("scripts", required: false)

</body>
</html>
