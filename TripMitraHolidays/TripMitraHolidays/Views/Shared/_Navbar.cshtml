@{
    var currentAction     = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLower();
    bool isHome     = currentController == "home"     && currentAction == "index";
    bool isPackages = currentController == "packages";
    bool isAbout    = currentController == "home"     && currentAction == "about";
}

<nav class="navbar">
    <a href="@Url.Action("Index","Home")" class="logo">
        <img src="~/Content/images/logo.png" alt="Trip Mitra Holidays" class="sidebar-logo" />
    </a>

    <div class="nav-links">
        <a href="@Url.Action("Index","Home")"     class="nav-link @(isHome     ? "active" : "")">Home</a>
        <a href="@Url.Action("Index","Packages")" class="nav-link @(isPackages ? "active" : "")">Packages</a>
        <a href="@Url.Action("About","Home")"     class="nav-link @(isAbout    ? "active" : "")">About</a>
        <a href="@Url.Action("Index","Inquiry")" class="nav-enquire">
            <i class="fa-solid fa-plane"></i> Enquire Now
        </a>
    </div>

    <div class="hamburger" id="hamburger" onclick="toggleMenu()" aria-label="Toggle menu">
        <span></span><span></span><span></span>
    </div>
</nav>

<div class="mobile-nav" id="mobileNav">
    <a href="@Url.Action("Index","Home")"     class="nav-link @(isHome     ? "active" : "")" onclick="closeMenu()">Home</a>
    <a href="@Url.Action("Index","Packages")" class="nav-link @(isPackages ? "active" : "")" onclick="closeMenu()">Packages</a>
    <a href="@Url.Action("About","Home")"     class="nav-link @(isAbout    ? "active" : "")" onclick="closeMenu()">About</a>
    <a href="@Url.Action("Index","Home")#enquire" class="nav-enquire" onclick="closeMenu()">
        <i class="fa-solid fa-plane"></i> Enquire Now
    </a>
</div>
