@using System.Configuration
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section" style="min-height:60vh;">
    <div class="section-header">
        <div>
            <div class="eyebrow">Legal</div>
            <h1 class="section-h2">Privacy <span>Policy</span></h1>
        </div>
    </div>

    <div style="max-width:800px;font-size:14px;color:#444;line-height:1.9;">
        <p style="margin-bottom:16px;"><em>Last updated: October 2026</em></p>

        <p style="margin-bottom:16px;">
            Trip Mitra Holidays ("we", "us", "our") respects your privacy and is committed to protecting the
            personal information you share with us when you enquire about or book a holiday package through
            this website.
        </p>

        <h3 style="margin:24px 0 10px;">1. Information We Collect</h3>
        <p style="margin-bottom:16px;">
            When you submit an enquiry or booking request, we collect your name, mobile number, email address,
            preferred destination, travel dates, number of travellers and any message you provide. We may also
            collect standard technical data (IP address, browser type, pages visited) through cookies and
            analytics tools to improve the website.
        </p>

        <h3 style="margin:24px 0 10px;">2. How We Use Your Information</h3>
        <p style="margin-bottom:16px;">
            Your information is used to respond to enquiries, prepare travel quotes and itineraries, process
            bookings, send booking-related communication (confirmations, vouchers, payment reminders), and —
            where you've consented — to share offers and travel updates. We do not sell your personal
            information to third parties.
        </p>

        <h3 style="margin:24px 0 10px;">3. Sharing With Third Parties</h3>
        <p style="margin-bottom:16px;">
            We share necessary booking details (name, travel dates, passport/ID details where required) with
            hotels, airlines, transport operators and other travel service providers solely to fulfil your
            booking. These partners are expected to handle your data securely.
        </p>

        <h3 style="margin:24px 0 10px;">4. Data Security</h3>
        <p style="margin-bottom:16px;">
            We take reasonable technical and organisational measures to protect your data against unauthorised
            access, alteration or disclosure. No method of transmission over the internet is 100% secure, and
            we cannot guarantee absolute security.
        </p>

        <h3 style="margin:24px 0 10px;">5. Cookies</h3>
        <p style="margin-bottom:16px;">
            This website may use cookies to remember your preferences and understand how visitors use the site.
            You can disable cookies in your browser settings, though some features may not work as intended.
        </p>

        <h3 style="margin:24px 0 10px;">6. Your Rights</h3>
        <p style="margin-bottom:16px;">
            You may request access to, correction of, or deletion of the personal information we hold about you
            by contacting us at <a href="mailto:@ConfigurationManager.AppSettings["CompanyEmail"]">@ConfigurationManager.AppSettings["CompanyEmail"]</a>.
        </p>

        <h3 style="margin:24px 0 10px;">7. Changes to This Policy</h3>
        <p style="margin-bottom:16px;">
            We may update this Privacy Policy from time to time. Changes will be posted on this page with an
            updated revision date.
        </p>

        <h3 style="margin:24px 0 10px;">8. Contact Us</h3>
        <p style="margin-bottom:32px;">
            For any privacy-related questions, write to us at
            <a href="mailto:@ConfigurationManager.AppSettings["CompanyEmail"]">@ConfigurationManager.AppSettings["CompanyEmail"]</a> or call
            <a href="tel:@ConfigurationManager.AppSettings["CompanyPhoneE164"]">@ConfigurationManager.AppSettings["CompanyPhoneDisplay"]</a>.
        </p>
    </div>
</section>
