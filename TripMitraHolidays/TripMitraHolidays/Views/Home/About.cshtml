@using System.Configuration
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.MetaTitle       = ViewBag.MetaTitle ?? "About Us | Trip Mitra Holidays";
    ViewBag.MetaDescription = ViewBag.MetaDescription ?? "Learn about Trip Mitra Holidays – your trusted travel partner for crafting unforgettable journeys since 2018.";
}

<section class="section" style="min-height:60vh;">
    <div class="section-header">
        <div>
            <div class="eyebrow">Our Story</div>
            <h1 class="section-h2">About <span>Trip Mitra</span> Holidays</h1>
        </div>
    </div>

    <div style="max-width:800px;font-size:14px;color:#444;line-height:1.9;text-align:justify;">
        <p style="margin-bottom:16px;">
            <strong>Trip Mitra Holidays</strong>  was founded by two childhood friends
            who share a common passion for travel and a commitment to delivering exceptional holiday experiences.
        </p>
        <p style="margin-bottom:16px;">
            Combining extensive travel industry expertise with modern technology,
            we created  <strong>Trip Mitra Holidays</strong> with a simple vision to make travel
            planning reliable, transparent, and enjoyable for every traveller.
        </p>
        <p style="margin-bottom:32px;">
            Since @(DateTime.Now.Year - (int)ViewBag.YearsExperience), we've built @ViewBag.YearsExperience+ years of travel industry
            experience and extensive on-ground knowledge across India and international destinations, with our team bringing
            deep destination expertise, trusted supplier relationships, and a strong understanding of what makes a journey
            truly memorable.
        </p>

        <p style="margin-bottom:32px;">
            At the same time, our technology-driven approach helps us provide a modern, efficient, and customer-friendly experience
            through faster communication, organized travel planning, seamless documentation, and reliable support throughout the journey.
        </p>

        <p style="margin-bottom:32px;">
            At  <strong>Trip Mitra Holidays</strong>, we believe that the best holidays are built on trust, attention to detail, and genuine 
            care for our guests. Whether it's a family vacation, honeymoon, group tour, spiritual journey, 
            or an international getaway, our goal is to create seamless
            travel experiences that allow you to focus on making memories while we take care of the rest.
        </p>
        <p style="margin-bottom:32px;">
            More than just a travel company, <strong>Trip Mitra Holidays</strong> is your trusted travel companion from your 
            first enquiry to your safe return home.
        </p>

        <a href="@Url.Action("Index","Home")#enquire" class="btn-cta-fill" style="display:inline-block;">
            <i class="fa-solid fa-plane"></i> Plan Your Holiday
        </a>
    </div>
</section>

<div class="trust-strip" style="padding-top:0;">
    <div class="trust-item">
        <div class="trust-icon"><i class="fa-solid fa-plane"></i></div>
        <div class="trust-num">@ViewBag.DestinationsCount+</div>
        <div class="trust-lbl">Destinations</div>
    </div>
    <div class="trust-item">
        <div class="trust-icon"><i class="fa-solid fa-face-smile"></i></div>
        <div class="trust-num">@ViewBag.HappyTravellers</div>
        <div class="trust-lbl">Happy Travellers</div>
    </div>
    <div class="trust-item">
        <div class="trust-icon"><i class="fa-solid fa-star"></i></div>
        <div class="trust-num">@ViewBag.AverageRating</div>
        <div class="trust-lbl">Average Rating</div>
    </div>
    <div class="trust-item">
        <div class="trust-icon"><i class="fa-solid fa-trophy"></i></div>
        <div class="trust-num">@ViewBag.YearsExperience+</div>
        <div class="trust-lbl">Years Experience</div>
    </div>
</div>

@* ── Business trust & credentials — populated from web.config AppSettings; a blank value hides that row ── *@
@{
    string gst        = ConfigurationManager.AppSettings["GstNumber"];
    string regNo       = ConfigurationManager.AppSettings["BusinessRegistrationNo"];
    string address     = ConfigurationManager.AppSettings["OfficeAddress"];
    string mapEmbed    = ConfigurationManager.AppSettings["GoogleMapsEmbedUrl"];
    string iata        = ConfigurationManager.AppSettings["IataNumber"];
    string taai        = ConfigurationManager.AppSettings["TaaiNumber"];
    bool hasCredentials = !string.IsNullOrEmpty(gst) || !string.IsNullOrEmpty(regNo)
                        || !string.IsNullOrEmpty(address) || !string.IsNullOrEmpty(iata) || !string.IsNullOrEmpty(taai);
}
@if (hasCredentials)
{
    <section class="section" style="max-width:800px;">
        <div class="section-header">
            <div>
                <div class="eyebrow">Verified Business</div>
                <h2 class="section-h2">Our <span>Credentials</span></h2>
            </div>
        </div>
        <ul style="list-style:none;padding:0;font-size:14px;color:#444;line-height:2;">
            @if (!string.IsNullOrEmpty(regNo))
            {
                <li><i class="fa-solid fa-building" style="color:#c9a227;width:20px;"></i> Business Registration No.: @regNo</li>
            }
            @if (!string.IsNullOrEmpty(gst))
            {
                <li><i class="fa-solid fa-file-invoice" style="color:#c9a227;width:20px;"></i> GSTIN: @gst</li>
            }
            @if (!string.IsNullOrEmpty(iata))
            {
                <li><i class="fa-solid fa-plane-circle-check" style="color:#c9a227;width:20px;"></i> IATA No.: @iata</li>
            }
            @if (!string.IsNullOrEmpty(taai))
            {
                <li><i class="fa-solid fa-award" style="color:#c9a227;width:20px;"></i> TAAI Member No.: @taai</li>
            }
            @if (!string.IsNullOrEmpty(address))
            {
                <li><i class="fa-solid fa-location-dot" style="color:#c9a227;width:20px;"></i> @address</li>
            }
        </ul>
        @if (!string.IsNullOrEmpty(mapEmbed))
        {
            <div style="margin-top:16px;border-radius:12px;overflow:hidden;">
                <iframe src="@mapEmbed" width="100%" height="300" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Trip Mitra Holidays office location"></iframe>
            </div>
        }
    </section>
}

@section structuredData
{
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "Home", "item": "@(Url.Action("Index", "Home", null, Request.Url.Scheme))" },
            { "@@type": "ListItem", "position": 2, "name": "About Us", "item": "@(Url.RouteUrl("About", null, Request.Url.Scheme))" }
        ]
    }
    </script>
}
