@model TripMitraHolidays.Core.ViewModels.HomeViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.MetaTitle       = Model.MetaTitle;
    ViewBag.MetaDescription = Model.MetaDescription;
    ViewBag.OgImage         = Model.OgImage;
}

@* ════════════════════════════════════════════════
   HERO SLIDER
   ════════════════════════════════════════════════ *@
@if (Model.SliderPackages.Any())
{
    <div class="slider-section" id="heroSlider">
        <div class="slider-track" id="sliderTrack">

            @for (int i = 0; i < Model.SliderPackages.Count; i++)
            {
                var slide = Model.SliderPackages[i];
                string imgSrc = string.IsNullOrEmpty(slide.ThumbnailImage)
                    ? "https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=1400&q=80&fit=crop&crop=center"
                    : slide.ThumbnailImage;

                string tagText = (!string.IsNullOrEmpty(slide.PackageType) ? slide.PackageType : "Holiday")
                               + (!string.IsNullOrEmpty(slide.TourCategory) ? " &middot; " + slide.TourCategory : "");

                <div class="slide @(i == 0 ? "active" : "")">
                    @if (i == 0)
                    {
                        <img src="@imgSrc" alt="@slide.PackageName" loading="eager" />
                    }
                    else
                    {
                        <img src="@imgSrc" alt="@slide.PackageName" loading="lazy" />
                    }
                    <div class="slide-overlay"></div>
                    <div class="slide-content">
                        <div class="slide-tag">
                            <i class="fa-solid fa-circle-dot"></i> @Html.Raw(tagText)
                        </div>
                        <h1 class="slide-h1">@slide.PackageName</h1>
                        @if (!string.IsNullOrEmpty(slide.ShortDescription))
                        {
                            <p class="slide-desc">@slide.ShortDescription</p>
                        }
                        <div class="slide-price-tag">
                            <span class="slide-price-from">Starting from</span>
                            <span class="slide-price-amt">&#8377;@slide.DisplayPrice.ToString("N0")</span>
                            <span class="slide-price-pp">per person</span>
                        </div>
                        <div class="slide-btns">
                            <a href="@Url.RouteUrl("PackageDetail", new { slug = slide.Slug })" class="slide-btn-gold">
                                <i class="fa-solid fa-compass"></i> View Package
                            </a>
                            <a href="#enquire" class="slide-btn-ghost">
                                <i class="fa-solid fa-paper-plane"></i> Get Free Quote
                            </a>
                        </div>
                    </div>
                </div>
            }

        </div>@* /slider-track *@

        <div class="slide-stats">
            <div class="stat-bubble"><div class="stat-bubble-num">500+</div><div class="stat-bubble-lbl">Destinations</div></div>
            <div class="stat-bubble"><div class="stat-bubble-num">10K+</div><div class="stat-bubble-lbl">Happy Clients</div></div>
            <div class="stat-bubble"><div class="stat-bubble-num">15+</div><div class="stat-bubble-lbl">Years Expertise</div></div>
        </div>

        <div class="slider-arrow prev" id="prevBtn" onclick="changeSlide(-1)" aria-label="Previous slide">&#8249;</div>
        <div class="slider-arrow next" id="nextBtn" onclick="changeSlide(1)"  aria-label="Next slide">&#8250;</div>
        <div class="slider-dots" id="sliderDots"></div>
        <div class="slider-progress" id="sliderProgress"></div>
    </div>
}
else
{
    <div class="slider-section">
        <div class="slider-empty">
            <h2><i class="fa-solid fa-earth-americas"></i> Discover the World with TripMitra</h2>
            <p>Exciting packages coming soon. <a href="#enquire" style="color:#c9a227;">Enquire now</a> for custom itineraries.</p>
        </div>
    </div>
}

@* ════════════════════════════════════════════════
   PACKAGES SECTION
   ════════════════════════════════════════════════ *@
<section class="section" id="packages">
    <div class="section-header">
        <div>
            <div class="eyebrow">Handpicked For You</div>
            <h2 class="section-h2">Top <span>Holiday</span> Packages</h2>
        </div>
        <a href="@Url.Action("Index","Packages")" class="view-all">
            View All Packages <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>

    <div class="filter-tabs">
        <div class="tab active"                      onclick="filterTab(this,'all')">All</div>
        <div class="tab" onclick="filterTab(this,'international')">International</div>
        <div class="tab" onclick="filterTab(this,'domestic')">Domestic India</div>
        <div class="tab" onclick="filterTab(this,'honeymoon')">Honeymoon</div>
        <div class="tab" onclick="filterTab(this,'adventure')">Adventure</div>
        <div class="tab" onclick="filterTab(this,'family')">Family</div>
    </div>

    <div class="packages-grid" id="packagesGrid">
        @if (Model.FeaturedPackages.Any())
        {
            foreach (var pkg in Model.FeaturedPackages)
            {
                @Html.Partial("_PackageCard", pkg)
            }
        }
        else
        {
            <div class="packages-empty">
                <div style="font-size:48px;"><i class="fa-solid fa-umbrella-beach" style="color:#c9a227;"></i></div>
                <p>Holiday packages are being added. Check back soon or <a href="#enquire">enquire now</a>.</p>
            </div>
        }
    </div>
</section>

@* ════════════════════════════════════════════════
   CTA BANNER
   ════════════════════════════════════════════════ *@
<div class="cta-banner" id="enquire">
    <div class="cta-text">
        <h3><i class="fa-solid fa-compass"></i> Can't find your dream destination?</h3>
        <p>
            Tell us where you want to go — our travel experts will craft a custom itinerary
            just for you, completely free. No obligation, just great travel planning.
        </p>
    </div>
    <div class="cta-btns">
        <a href="tel:+919724895328" class="btn-cta-outline">
            <i class="fa-solid fa-phone"></i> Call Us
        </a>
        <a href="mailto:booking@tripmitraholidays.com" class="btn-cta-fill">
            <i class="fa-solid fa-envelope"></i> Send Enquiry
        </a>
    </div>
</div>

@* ════════════════════════════════════════════════
   TRUST STRIP
   ════════════════════════════════════════════════ *@
<div class="trust-strip">
    <div class="trust-item">
        <div class="trust-icon"><i class="fa-solid fa-plane"></i></div>
        <div class="trust-num">500+</div>
        <div class="trust-lbl">Destinations Covered</div>
    </div>
    <div class="trust-item">
        <div class="trust-icon"><i class="fa-solid fa-face-smile"></i></div>
        <div class="trust-num">10,000+</div>
        <div class="trust-lbl">Happy Travellers</div>
    </div>
    <div class="trust-item">
        <div class="trust-icon"><i class="fa-solid fa-star"></i></div>
        <div class="trust-num">4.9 / 5</div>
        <div class="trust-lbl">Average Rating</div>
    </div>
    <div class="trust-item">
        <div class="trust-icon"><i class="fa-solid fa-trophy"></i></div>
        <div class="trust-num">15+</div>
        <div class="trust-lbl">Years of Experience</div>
    </div>
</div>

@* ════════════════════════════════════════════════
   POPULAR DESTINATIONS
   ════════════════════════════════════════════════ *@
@if (Model.PopularDestinations.Any())
{
    <section class="section" id="destinations">
        <div class="section-header">
            <div>
                <div class="eyebrow">Explore By Place</div>
                <h2 class="section-h2">Popular <span>Destinations</span></h2>
            </div>
            <a href="@Url.Action("Index","Packages")" class="view-all">
                All Destinations <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
    </section>
    <div class="dest-row">
        @foreach (var dest in Model.PopularDestinations)
        {
            string destImg = string.IsNullOrEmpty(dest.ImageUrl)
                ? "https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=400&q=80&fit=crop"
                : dest.ImageUrl;
            <a href="@Url.Action("Index","Packages")?category=@dest.Slug" class="dest-tile">
                <img src="@destImg" alt="@dest.Name" loading="lazy" width="400" height="533" />
                <div class="dest-tile-name">@dest.Name</div>
                <div class="dest-tile-count">@dest.PackageCount package@(dest.PackageCount != 1 ? "s" : "")</div>
            </a>
        }
    </div>
}

